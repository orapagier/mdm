{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Download Manager",
  "version": "1.1.0",
  "identifier": "io.github.orapagier.mdm",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/orapagier/mdm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MjA3MjA1NUU3NDlGRkUKUldUK24zUmVCWElnWk5XdnlPeFpidzQwWkRaY0p4RkFKRXBEMW9xOSs4OSs4UTFtWDFTZERvenYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/mdm-256.png",
      "icons/mdm-512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Accelerated download manager",
    "longDescription": "Captures downloads from Firefox and fetches them with up to 32 parallel connections in its own process, with queueing, scheduling, categories, and native HLS/DASH download and remuxing.",
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
