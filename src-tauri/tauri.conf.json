{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Download Manager",
  "version": "1.0.0",
  "identifier": "io.ldm.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "My Download Manager",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Network",
    "shortDescription": "Accelerated download manager for Linux",
    "longDescription": "Captures downloads from Firefox and fetches them with up to 16 parallel connections via aria2, with queueing, scheduling, categories and yt-dlp support.",
    "linux": {
      "deb": { "depends": ["aria2"] },
      "rpm": { "depends": ["aria2"] }
    }
  }
}
