{
  "manifest_version": 3,
  "name": "My Download Manager",
  "short_name": "MDM",
  "version": "1.0.0",
  "description": "Capture every download — binaries, archives, documents, media — and hand it to MDM for accelerated multi-connection downloading.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "webNavigation",
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "cookies",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "action": {
    "default_title": "My Download Manager",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/mdm-16.png",
      "32": "icons/mdm-32.png",
      "64": "icons/mdm-64.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/mdm-16.png",
    "32": "icons/mdm-32.png",
    "64": "icons/mdm-64.png",
    "128": "icons/mdm-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/polyfill.js",
        "src/content/blob.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/polyfill.js",
        "src/content/video-panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
