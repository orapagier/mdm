# Rust build artifacts
/target/
**/target/

# Python bytecode
__pycache__/
*.py[cod]

# Editor / OS cruft
*.swp
*~
.DS_Store

# Generated by Tauri
src-tauri/gen/schemas/

# Staged by install.ps1 -Installer: Tauri's sidecar naming wants the target
# triple in the filename, and the file is a copy of a build artifact.
src-tauri/binaries/

# The Chromium extension's signing key. Its public half is pinned in
# manifest.chrome.json, which is what fixes the extension id; the private half
# is what would let someone else publish under that id, so it stays here.
packaging/chrome-extension-key.pem

# The updater's signing key. Its public half is in tauri.conf.json, which is
# what every installed copy checks a new version against; the private half is
# what would let someone else sign one, so it stays here.
packaging/mdm-updater.key

# Built installers, staged beside the source so they are easy to find from the
# host that shares this directory. Build output, not source.
/dist/

# The packaged extension. install.ps1 builds it into target\ and copies it
# where the browser can reach it, so the copy left beside the source is output
# rather than source. The signed one is not built at all -- it comes back from
# addons.mozilla.org -- but it is still six hundred kilobytes of the same
# thing, and install.ps1 finds it here whether or not git is carrying it.
/mdm-firefox.xpi
packaging/mdm-firefox-signed.xpi

# The passphrase for the updater key above. Kept beside it rather than in the
# script, because Windows cannot hold an empty environment variable -- a key
# with no passphrase simply cannot be passed to the bundler from PowerShell.
packaging/mdm-updater.password
